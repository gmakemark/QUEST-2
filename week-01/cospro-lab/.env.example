# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 .gitignore 에 들어 있어서 GitHub 에 올라가지 않습니다.

# 관리자 비밀번호의 SHA-256 해시 (비밀번호 자체가 아니라 해시값!)
# 만드는 법: node -e "console.log(require('crypto').createHash('sha256').update('내비밀번호').digest('hex'))"
# 비워 두면, 처음 관리자 모드에 들어갈 때 그 브라우저에서 비밀번호를 새로 만듭니다.
VITE_ADMIN_PASSWORD_HASH=
